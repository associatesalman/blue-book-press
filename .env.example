# Copy to .env.local (never commit it) and fill in. Values are read only on the
# server (src/lib/delivery.ts, src/app/api/*) and are never sent to the browser.
#
# Without any delivery configured, every form shows an honest "not sent" message
# with an email fallback — no form ever reports success unless delivery worked.

# ---------------------------------------------------------------------------
# Option A — email delivery through Resend (https://resend.com)
# Used by the Consultation, Start Your Book and FAQ contact forms.
# Uploaded manuscripts/samples are attached to the email.
# ---------------------------------------------------------------------------
# API key from the Resend dashboard (starts with "re_").
RESEND_API_KEY=
# Where enquiries are delivered. Separate several addresses with commas.
FORMS_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "Blue Book Press <forms@yourdomain.com>".
FORMS_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Option B — webhooks (CRM, form service or automation tool such as Zapier,
# Make or n8n). Each receives the submission as JSON; an uploaded file arrives
# as { filename, contentType, size, base64 } in the "attachment" field.
# If both A and B are set, each submission is sent to both.
# ---------------------------------------------------------------------------
# Consultation requests (src/app/api/consultation/route.ts)
CONSULTATION_WEBHOOK_URL=
# Start Your Book project forms (src/app/api/start-your-book/route.ts)
PROJECT_WEBHOOK_URL=
# FAQ-page contact enquiries (src/app/api/contact/route.ts)
CONTACT_WEBHOOK_URL=

# Articles-page newsletter sign-ups (src/app/api/newsletter/route.ts).
# Point this at your email-marketing platform's signup webhook.
NEWSLETTER_WEBHOOK_URL=
